<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white2">






    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="600dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="570dp"
                android:orientation="vertical"
                android:layout_marginTop="30dp"
                android:background="@drawable/vien_trang"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"

                >


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@drawable/duong_vien_tren_blue"
                    >

                    <TextView
                        android:id="@+id/txtcau"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=" 1"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15dp"
                        android:padding="15dp"/>


                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/hoithoai"
                    android:textStyle="bold"
                    android:textColor="@color/white"

                    android:padding="10dp"
                    android:textSize="15dp"
                    android:background="@color/blue"/>


                <TextView
                    android:id="@+id/txtcauhoi1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="cau hoi 1"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:padding="15dp"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/radioGroup1"
                    android:orientation="vertical"
                    >

                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb11"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb22"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb33"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb44"/>


                </RadioGroup>




                <TextView
                    android:id="@+id/txtcauhoi2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="cau hoi 2"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:padding="15dp"
                    android:layout_marginTop="20dp"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/radioGroup2"
                    android:orientation="vertical"
                    >

                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb2_11"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb2_22"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb2_33"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb2_44"/>


                </RadioGroup>


                <TextView
                    android:id="@+id/txtcauhoi3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="cau hoi 3"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:padding="15dp"
                    android:layout_marginTop="20dp"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/radioGroup3"
                    android:orientation="vertical"
                    >

                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb3_11"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb3_22"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb3_33"/>



                    <RadioButton
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:padding="5dp"
                        android:id="@+id/rb3_44"/>


                </RadioGroup>



        </LinearLayout>


    </ScrollView>








    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/white"
        android:orientation="vertical"
        >


        <ImageView
            android:id="@+id/imageViewplay"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:srcCompat="@drawable/circle_play_solid_full"
            android:layout_marginStart="10dp"
            android:layout_marginTop="40dp"/>

        <ImageView
            android:id="@+id/imageViewRestart"
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/rotate_right_solid_full"
            android:layout_marginStart="50dp"
            android:layout_marginTop="-28dp"
            />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="350dp"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/black"
            android:thumbTint="@color/black"
            android:layout_marginTop="-25dp"
            android:layout_marginStart="75dp"
            />







    </LinearLayout>










</androidx.constraintlayout.widget.ConstraintLayout>